{
    "name": "ismailnakkar/laravel-mail-content",
    "description": "The shared contract for package mail in Laravel: what a mail says, as ordered plain-text blocks, and the one template an app lays every package's mail out with.",
    "keywords": [
        "laravel",
        "mail",
        "notifications",
        "email-template",
        "contracts"
    ],
    "homepage": "https://github.com/ismailnakkar/laravel-mail-content",
    "license": "MIT",
    "authors": [
        {
            "name": "Ismail Nakkar",
            "email": "juge.steam@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ismailnakkar/laravel-mail-content/issues"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5.8 || ^13.0",
        "symfony/css-selector": "^6.4.3 || ^7.0.3 || ^8.0",
        "tijsverkoyen/css-to-inline-styles": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "MailContent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailContent\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@lint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
